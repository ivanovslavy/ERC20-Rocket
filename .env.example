# Copy this file to .env and replace the example values with your own.
# The .env file is git-ignored and must NEVER be committed.
# The values below are EXAMPLES only - they are not real and will not work.

# --- Deployer ---
# Private key of the wallet that deploys (64 hex chars, with or without 0x).
PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111

# --- Ankr RPC API keys (fallback order - if one fails, the next is used) ---
# Comma-separated. Get them at https://www.ankr.com/rpc/ (one project can have several keys).
# Used for all chains (eth, sepolia, base, bsc, polygon).
ANKR_API_KEYS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# --- Optional explicit RPC overrides (if empty, Ankr is used) ---
# Set any of these to a full RPC URL to override the Ankr endpoint for that chain.
ETHEREUM_RPC_URL=https://eth-mainnet.example-rpc.com/v3/your-key
SEPOLIA_RPC_URL=https://eth-sepolia.example-rpc.com/v3/your-key
BASE_RPC_URL=https://mainnet.base.org
BNB_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Fork URL for the mainnet fork test (if empty, the first Ankr eth URL is used) ---
FORK_URL=https://eth-mainnet.example-rpc.com/v3/your-key

# --- Block explorer API key ---
# Etherscan API V2: a single key from https://etherscan.io/myapikey covers all chains
# (Ethereum, Sepolia, Base, BNB Chain, Polygon...).
ETHERSCAN_API_KEY=ABCD1234ABCD1234ABCD1234ABCD1234AB
