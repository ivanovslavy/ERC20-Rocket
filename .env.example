# --- Deployer ---
# Privaten klyuch na portfeila ot koito se deplova. NIKOGA ne commitvai realnia .env!
PRIVATE_KEY=

# --- Ankr RPC API klyuchove (fallback red - ako edin feilne, sledvashtia) ---
# Zapeti-razdeleni. Polzvat se za vsichki verigi (eth, sepolia, base, bsc, polygon).
ANKR_API_KEYS=

# --- Optsionalni vanshni RPC override-i (ako sa prazni, se polzva Ankr) ---
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
BASE_RPC_URL=
BNB_RPC_URL=
POLYGON_RPC_URL=

# --- Fork URL za mainnet fork test (ako e prazno, se polzva purviat Ankr eth) ---
FORK_URL=

# --- Block explorer API klyuchove ---
# Etherscan API V2: edin klyuch ot https://etherscan.io/myapikey pokriva vsichki verigi.
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
